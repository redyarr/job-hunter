# === App ===
NODE_ENV=development

# === Database ===
DATABASE_URL="file:./data/jobs.sqlite"

# === Telegram Client (your personal account — reads channels) ===
# Get these from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Generated by `npm run telegram:login` on first run — paste the printed string here after.
TELEGRAM_SESSION=

# === Telegram Bot (sends you notifications, handles button taps) ===
# Create via @BotFather
TELEGRAM_BOT_TOKEN=
# Your personal chat ID (the bot only ever messages you). Get it by messaging
# @userinfobot or your own bot once and checking the update payload.
TELEGRAM_USER_CHAT_ID=

# Comma-separated channel usernames or IDs to monitor
TELEGRAM_JOB_CHANNELS=

# === Gmail (OAuth2, gmail.send scope only) ===
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/oauth2callback
# Populated after first-time `npm run gmail:login` style flow (added in Phase 6)
GMAIL_REFRESH_TOKEN=

# === AI Providers (the code automatically falls back in order to any keys you populate below) ===
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENAI_API_KEY=

# Legacy configuration (optional, if you want to explicitly pin a single backend key)
AI_PROVIDER=gemini
AI_API_KEY=

# === CV ===
CV_PATH=./data/cv/my-cv.pdf
